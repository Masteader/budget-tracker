<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (every supported device: minSdk is 26). The launcher
     masks this one icon to its own shape, circle included, so no separate
     ic_launcher_round is needed. The foreground and monochrome PNGs are
     rendered from docs/brand/qawam_money_logo.svg with the mark inside the
     66 dp safe zone. The legacy mipmap-*/ic_launcher.png are kept unchanged as
     the fallback for anything that cannot read adaptive icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
