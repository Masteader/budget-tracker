<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon background: the cream tile of
     docs/brand/qawam_money_logo.svg. Its gradient runs top to bottom across
     the 72 dp the launcher masks show (18 dp to 90 dp of the 108 dp canvas),
     as the master's runs across its tile, and is clamped beyond. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90"
                android:startColor="#FDFBF6"
                android:endColor="#EEE8DC"
                android:tileMode="clamp" />
        </aapt:attr>
    </path>
</vector>
