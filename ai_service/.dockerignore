# Keep secrets, local state and dev tooling out of the image (`COPY . .` copied all of it,
# including a developer's .env with the Supabase service key).
.env
.env.*
!.env.example
**/__pycache__/
**/*.py[cod]
.pytest_cache/
tests/
data/*.json
# Manual dev scripts (they call a running server or a real LLM)
test_chat.py
test_chat_endpoint.py
test_zatca.py
_build_landing.py
docker-compose.yml
Dockerfile
.dockerignore
