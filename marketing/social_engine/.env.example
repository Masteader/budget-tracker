# Template only. Keep every value empty in this file.
# The real file is %LOCALAPPDATA%\SocialEngine\.env, outside OneDrive. The owner enters the
# values there. Agents and tests never read it.

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=

# Must match the region of the resource, for example uaenorth.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Only when llm.backend is anthropic_api or llm.auth is api_key.
ANTHROPIC_API_KEY=

# Phase 2 only.
PUBLISHER_API_KEY=
